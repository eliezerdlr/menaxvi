{
  "apiVersion": "menaxvi.io/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "id": "workflow.reviewed-multichannel-campaign",
    "version": "1.0.0",
    "title": "Produce a reviewed multichannel campaign",
    "status": "active",
    "provenanceRef": {"kind": "ProvenanceRecord", "id": "provenance.reviewed-multichannel-campaign", "version": "1.0.0"}
  },
  "spec": {
    "purpose": "Build a complete multichannel campaign package and require human approval before handoff or activation.",
    "inputs": [
      {"name": "brief", "required": true, "schema": {"type": "object"}},
      {"name": "evidence", "required": true, "schema": {"type": "array"}}
    ],
    "nodes": [{
      "id": "build-and-review",
      "taskRef": {"kind": "Task", "id": "task.build-multichannel-campaign", "version": "1.0.0"},
      "dependsOn": [],
      "inputBindings": {"brief": "workflow.inputs.brief", "evidence": "workflow.inputs.evidence"}
    }],
    "gates": [{
      "id": "human-approval",
      "type": "human",
      "afterNodes": ["build-and-review"],
      "approverRole": "Authorized campaign reviewer",
      "decisionOptions": ["approve_campaign", "request_revision", "reject"],
      "evidenceRequired": true
    }],
    "outputs": [{
      "name": "reviewed-campaign-package",
      "source": "build-and-review outputs plus human-approval decision",
      "schema": {"type": "object", "required": ["campaign", "claimLedger", "qualityReview", "gateDecision"]}
    }],
    "failurePolicy": {"strategy": "manual-intervention", "maxAttempts": 2},
    "evidencePolicy": {"recordInputs": true, "recordDecisions": true, "recordOutputs": true, "retentionDays": 365},
    "policies": [
      {"policyId": "policy.claims-require-evidence", "enforcement": "required"},
      {"policyId": "policy.human-approval-before-publication", "enforcement": "required"}
    ]
  }
}

{
  "apiVersion": "menaxvi.io/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "id": "workflow.reviewed-campaign-message",
    "version": "1.0.0",
    "title": "Produce a reviewed campaign message",
    "status": "active",
    "provenanceRef": {
      "kind": "ProvenanceRecord",
      "id": "provenance.reviewed-campaign-message",
      "version": "1.0.0"
    }
  },
  "spec": {
    "purpose": "Run the governed drafting task and require human review before a message package can be handed off.",
    "inputs": [
      {
        "name": "brief",
        "required": true,
        "schema": {
          "type": "object"
        }
      },
      {
        "name": "evidence",
        "required": true,
        "schema": {
          "type": "array"
        }
      }
    ],
    "nodes": [
      {
        "id": "draft-and-review",
        "taskRef": {
          "kind": "Task",
          "id": "task.draft-campaign-message",
          "version": "1.0.0"
        },
        "dependsOn": [],
        "inputBindings": {
          "brief": "workflow.inputs.brief",
          "evidence": "workflow.inputs.evidence"
        }
      }
    ],
    "gates": [
      {
        "id": "human-approval",
        "type": "human",
        "afterNodes": ["draft-and-review"],
        "approverRole": "Authorized marketing reviewer",
        "decisionOptions": [
          "approve_draft",
          "request_revision",
          "reject"
        ],
        "evidenceRequired": true
      }
    ],
    "outputs": [
      {
        "name": "reviewed-message-package",
        "source": "draft-and-review outputs plus human-approval decision",
        "schema": {
          "type": "object",
          "required": ["draft", "claimLedger", "qualityReview", "gateDecision"]
        }
      }
    ],
    "failurePolicy": {
      "strategy": "manual-intervention",
      "maxAttempts": 2
    },
    "evidencePolicy": {
      "recordInputs": true,
      "recordDecisions": true,
      "recordOutputs": true,
      "retentionDays": 365
    },
    "policies": [
      {
        "policyId": "policy.claims-require-evidence",
        "enforcement": "required"
      },
      {
        "policyId": "policy.human-approval-before-publication",
        "enforcement": "required"
      }
    ]
  }
}

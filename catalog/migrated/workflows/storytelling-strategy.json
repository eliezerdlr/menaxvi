{
  "apiVersion": "menaxvi.io/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "id": "workflow.storytelling-strategy",
    "provenanceRef": {
      "id": "provenance.storytelling-workflow",
      "kind": "ProvenanceRecord",
      "version": "1.0.0"
    },
    "status": "active",
    "title": "Produce a reviewed narrative package",
    "version": "1.0.0"
  },
  "spec": {
    "evidencePolicy": {
      "recordDecisions": true,
      "recordInputs": true,
      "recordOutputs": true,
      "retentionDays": 365
    },
    "failurePolicy": {
      "maxAttempts": 2,
      "strategy": "manual-intervention"
    },
    "gates": [
      {
        "afterNodes": [
          "develop-and-review"
        ],
        "approverRole": "Authorized domain reviewer",
        "decisionOptions": [
          "approve_draft",
          "request_revision",
          "reject"
        ],
        "evidenceRequired": true,
        "id": "human-approval",
        "type": "human"
      }
    ],
    "inputs": [
      {
        "name": "narrative-brief",
        "required": true,
        "schema": {
          "type": "object"
        }
      },
      {
        "name": "audience-evidence",
        "required": true,
        "schema": {
          "type": "object"
        }
      },
      {
        "name": "claim-evidence",
        "required": true,
        "schema": {
          "type": "object"
        }
      }
    ],
    "nodes": [
      {
        "dependsOn": [],
        "id": "develop-and-review",
        "inputBindings": {
          "audience-evidence": "workflow.inputs.audience-evidence",
          "claim-evidence": "workflow.inputs.claim-evidence",
          "narrative-brief": "workflow.inputs.narrative-brief"
        },
        "taskRef": {
          "id": "task.storytelling-strategy",
          "kind": "Task",
          "version": "1.0.0"
        }
      }
    ],
    "outputs": [
      {
        "name": "reviewed-package",
        "schema": {
          "required": [
            "draft",
            "decisionLedger",
            "qualityReview",
            "gateDecision"
          ],
          "type": "object"
        },
        "source": "develop-and-review outputs plus human-approval decision"
      }
    ],
    "policies": [
      {
        "enforcement": "required",
        "policyId": "policy.claims-require-evidence"
      },
      {
        "enforcement": "required",
        "policyId": "policy.human-approval-before-publication"
      }
    ],
    "purpose": "Build truthful audience-centered narratives from approved facts, goals, and evidence. Require an authorized reviewer before handoff."
  }
}

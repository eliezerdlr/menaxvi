{
  "apiVersion": "menaxvi.io/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "id": "workflow.movement-strategy",
    "provenanceRef": {
      "id": "provenance.movement-workflow",
      "kind": "ProvenanceRecord",
      "version": "1.0.0"
    },
    "status": "active",
    "title": "Produce a reviewed community movement strategy",
    "version": "1.0.0"
  },
  "spec": {
    "evidencePolicy": {
      "recordDecisions": true,
      "recordInputs": true,
      "recordOutputs": true,
      "retentionDays": 365
    },
    "failurePolicy": {
      "maxAttempts": 2,
      "strategy": "manual-intervention"
    },
    "gates": [
      {
        "afterNodes": [
          "develop-and-review"
        ],
        "approverRole": "Authorized domain reviewer",
        "decisionOptions": [
          "approve_draft",
          "request_revision",
          "reject"
        ],
        "evidenceRequired": true,
        "id": "human-approval",
        "type": "human"
      }
    ],
    "inputs": [
      {
        "name": "community-brief",
        "required": true,
        "schema": {
          "type": "object"
        }
      },
      {
        "name": "stakeholder-evidence",
        "required": true,
        "schema": {
          "type": "object"
        }
      },
      {
        "name": "risk-assessment",
        "required": true,
        "schema": {
          "type": "object"
        }
      }
    ],
    "nodes": [
      {
        "dependsOn": [],
        "id": "develop-and-review",
        "inputBindings": {
          "community-brief": "workflow.inputs.community-brief",
          "risk-assessment": "workflow.inputs.risk-assessment",
          "stakeholder-evidence": "workflow.inputs.stakeholder-evidence"
        },
        "taskRef": {
          "id": "task.movement-strategy",
          "kind": "Task",
          "version": "1.0.0"
        }
      }
    ],
    "outputs": [
      {
        "name": "reviewed-package",
        "schema": {
          "required": [
            "draft",
            "decisionLedger",
            "qualityReview",
            "gateDecision"
          ],
          "type": "object"
        },
        "source": "develop-and-review outputs plus human-approval decision"
      }
    ],
    "policies": [
      {
        "enforcement": "required",
        "policyId": "policy.claims-require-evidence"
      },
      {
        "enforcement": "required",
        "policyId": "policy.human-approval-before-publication"
      }
    ],
    "purpose": "Design an ethical participation strategy that helps a community organize around a shared, lawful objective. Require an authorized reviewer before handoff."
  }
}

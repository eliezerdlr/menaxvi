{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.menaxvi.io/v1alpha1/workflow.schema.json",
  "title": "MENAXVI Workflow",
  "description": "A dependency graph of canonical tasks with explicit gates, failure handling, outputs, and evidence requirements.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "menaxvi.io/v1alpha1" },
    "kind": { "const": "Workflow" },
    "metadata": { "$ref": "common.schema.json#/$defs/resourceMetadata" },
    "spec": {
      "type": "object",
      "required": ["purpose", "inputs", "nodes", "gates", "outputs", "failurePolicy", "evidencePolicy", "policies"],
      "properties": {
        "purpose": { "type": "string", "minLength": 10, "maxLength": 500 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/dataContract" },
          "uniqueItems": true
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "taskRef", "dependsOn", "inputBindings"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
              "taskRef": { "$ref": "common.schema.json#/$defs/taskRef" },
              "dependsOn": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "uniqueItems": true
              },
              "inputBindings": {
                "type": "object",
                "propertyNames": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            },
            "additionalProperties": false
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id", "type", "afterNodes", "approverRole", "decisionOptions", "evidenceRequired"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
                  "type": { "const": "human" },
                  "afterNodes": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "common.schema.json#/$defs/canonicalId" },
                    "uniqueItems": true
                  },
                  "approverRole": { "type": "string", "minLength": 3, "maxLength": 120 },
                  "decisionOptions": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "uniqueItems": true
                  },
                  "evidenceRequired": { "type": "boolean" }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["id", "type", "afterNodes", "policy", "onFailure"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
                  "type": { "const": "policy" },
                  "afterNodes": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "common.schema.json#/$defs/canonicalId" },
                    "uniqueItems": true
                  },
                  "policy": { "$ref": "common.schema.json#/$defs/policyBinding" },
                  "onFailure": { "type": "string", "enum": ["stop", "request-review"] }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "source", "schema"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/canonicalId" },
              "source": { "type": "string", "minLength": 3, "maxLength": 300 },
              "schema": { "type": "object", "minProperties": 1 }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "failurePolicy": {
          "type": "object",
          "required": ["strategy", "maxAttempts"],
          "properties": {
            "strategy": { "type": "string", "enum": ["stop", "continue-independent", "manual-intervention"] },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 }
          },
          "additionalProperties": false
        },
        "evidencePolicy": {
          "type": "object",
          "required": ["recordInputs", "recordDecisions", "recordOutputs", "retentionDays"],
          "properties": {
            "recordInputs": { "type": "boolean" },
            "recordDecisions": { "type": "boolean" },
            "recordOutputs": { "type": "boolean" },
            "retentionDays": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/policyBinding" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

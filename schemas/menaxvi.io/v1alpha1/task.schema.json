{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.menaxvi.io/v1alpha1/task.schema.json",
  "title": "MENAXVI Task",
  "description": "A versioned unit of work owned by one canonical role and composed from canonical skills.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "menaxvi.io/v1alpha1" },
    "kind": { "const": "Task" },
    "metadata": { "$ref": "common.schema.json#/$defs/resourceMetadata" },
    "spec": {
      "type": "object",
      "required": [
        "purpose",
        "roleRef",
        "skillRefs",
        "inputs",
        "outputs",
        "preconditions",
        "steps",
        "acceptanceCriteria",
        "policies"
      ],
      "properties": {
        "purpose": { "type": "string", "minLength": 10, "maxLength": 500 },
        "roleRef": { "$ref": "common.schema.json#/$defs/roleRef" },
        "skillRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/skillRef" },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/dataContract" },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/dataContract" },
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/condition" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "instruction", "dependsOn"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
              "instruction": { "type": "string", "minLength": 5, "maxLength": 1000 },
              "dependsOn": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/condition" }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/policyBinding" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
